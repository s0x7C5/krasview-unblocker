{
  "manifest_version": 3,
  "name": "Krasview Unblocker",
  "version": "1.6.0",
  "description": "Чинит недоступное видео на витринах krasview: подставляет плееру рабочий источник.",
  "action": {
    "default_title": "Krasview Unblocker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://krasview.ru/video/*",
        "https://hlamer.ru/video/*",
        "https://zseek.ru/video/*",
        "https://smartkino.ru/video/*",
        "https://sersoap.ru/video/*",
        "https://qanime.ru/video/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://krasview.ru/video/*",
        "https://hlamer.ru/video/*",
        "https://zseek.ru/video/*",
        "https://smartkino.ru/video/*",
        "https://sersoap.ru/video/*",
        "https://qanime.ru/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://atoto.ru/*",
    "https://krasview.ru/*",
    "https://hlamer.ru/*",
    "https://zseek.ru/*",
    "https://smartkino.ru/*",
    "https://sersoap.ru/*",
    "https://qanime.ru/*",
    "https://*.krasview.ru/*"
  ]
}
